{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blindspot.local/schemas/submit_result.json",
  "title": "SubmitResult",
  "description": "Response of POST /api/attempts/{id}/submit in practice, drill and review modes. Assessment mode returns {recorded: true} instead and never includes ground truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "score",
    "success",
    "outcomes",
    "reveal",
    "facts_card",
    "debrief_status"
  ],
  "$defs": {
    "OutcomeResult": {
      "type": "string",
      "enum": [
        "found",
        "mislabeled",
        "missed_search",
        "missed_recognition",
        "missed_decision",
        "pattern_found",
        "pattern_missed",
        "pattern_false",
        "true_positive",
        "duplicate",
        "false_positive",
        "true_negative",
        "unmatched"
      ]
    },
    "Outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "result"
      ],
      "properties": {
        "target": {
          "type": "string",
          "description": "finding short id (F1), mark id (M1), or 'case' for true_negative"
        },
        "result": {
          "$ref": "#/$defs/OutcomeResult"
        },
        "dwell_ms": {
          "type": [
            "number",
            "null"
          ],
          "default": null
        },
        "zone": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "matched": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "for marks: the matched finding short id; for findings: the matched mark id"
        },
        "learner_label": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "size_verdict": {
          "type": [
            "object",
            "null"
          ],
          "default": null,
          "additionalProperties": true
        },
        "slices_viewed": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        }
      }
    },
    "RevealFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "label",
        "display",
        "kind",
        "bbox",
        "zones"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "description": "short id F<n>"
        },
        "label": {
          "type": "string"
        },
        "display": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "focal",
            "pattern"
          ]
        },
        "polygon": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "default": null
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "centroid": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "default": null
        },
        "side": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "zones": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "primary_zone": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "relative_location": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "result": {
          "$ref": "#/$defs/OutcomeResult"
        },
        "dwell_ms": {
          "type": [
            "number",
            "null"
          ],
          "default": null
        },
        "slice_range": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer"
          },
          "default": null
        },
        "centroid3": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "default": null
        },
        "label_values": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer"
          },
          "default": null
        },
        "components": {
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "label_value"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "label_value": {
                "type": "integer"
              }
            }
          }
        },
        "measure": {
          "type": [
            "object",
            "null"
          ],
          "default": null,
          "additionalProperties": false,
          "required": [
            "long_mm",
            "slice"
          ],
          "properties": {
            "long_mm": {
              "type": "number"
            },
            "slice": {
              "type": "integer"
            },
            "plane": {
              "type": "string",
              "enum": [
                "axial"
              ],
              "default": "axial"
            }
          }
        },
        "size_verdict": {
          "type": [
            "object",
            "null"
          ],
          "default": null,
          "additionalProperties": false,
          "required": [
            "your_mm",
            "reference_mm",
            "diff_mm",
            "diff_pct",
            "ok"
          ],
          "properties": {
            "your_mm": {
              "type": "number"
            },
            "reference_mm": {
              "type": "number"
            },
            "diff_mm": {
              "type": "number"
            },
            "diff_pct": {
              "type": "number"
            },
            "ok": {
              "type": "boolean"
            },
            "plane": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            }
          }
        },
        "signs": {
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "$ref": "#/$defs/Sign"
          }
        }
      }
    },
    "RevealMark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mark_id",
        "result"
      ],
      "properties": {
        "mark_id": {
          "type": "string"
        },
        "result": {
          "type": "string",
          "enum": [
            "true_positive",
            "duplicate",
            "false_positive",
            "unmatched"
          ]
        },
        "matched_finding": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "zone": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "voxel": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "default": null
        },
        "plane": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "slice": {
          "type": [
            "integer",
            "null"
          ],
          "default": null
        },
        "polygon": {
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "outline_verdict": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "on_target",
            "partly",
            "too_broad",
            "off",
            null
          ],
          "default": null
        }
      }
    },
    "Arrow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_mark",
        "to_finding",
        "text"
      ],
      "properties": {
        "from_mark": {
          "type": [
            "string",
            "null"
          ],
          "description": "mark id, or null = image centre"
        },
        "to_finding": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "from_xy": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "default": null
        },
        "to_xy": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "default": null
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "short on-film label (\u2264 6 words), e.g. 'higher, other lung'"
        }
      }
    },
    "SearchSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lung_coverage_pct",
        "unvisited_review_areas"
      ],
      "properties": {
        "lung_coverage_pct": {
          "type": "number"
        },
        "unvisited_review_areas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visited_review_areas": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "first_visits": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "time_to_first_mark_s": {
          "type": [
            "number",
            "null"
          ],
          "default": null
        },
        "total_time_s": {
          "type": [
            "number",
            "null"
          ],
          "default": null
        },
        "zoom_used": {
          "type": "boolean",
          "default": false
        },
        "loupe_used": {
          "type": "boolean",
          "default": false
        },
        "heatmap_png_b64": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "slice_dwell": {
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "plane",
              "slice",
              "ms",
              "has_finding"
            ],
            "properties": {
              "plane": {
                "type": "string"
              },
              "slice": {
                "type": "integer"
              },
              "ms": {
                "type": "number"
              },
              "has_finding": {
                "type": "boolean"
              },
              "finding_ids": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                },
                "default": null
              }
            }
          }
        },
        "slices_viewed_pct": {
          "type": [
            "number",
            "null"
          ],
          "default": null
        },
        "finding_slices_viewed": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "boolean"
          },
          "default": null,
          "description": "finding short id \u2192 whether any slice holding it was on screen \u2265 the threshold"
        }
      }
    },
    "Sign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "text",
        "geometry"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "e.g. 'Visceral pleural line'"
        },
        "text": {
          "type": "string",
          "description": "what to look for, one sentence, from the teaching card"
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "points"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "polyline",
                "polygon",
                "circle",
                "arrow",
                "segment",
                "band"
              ]
            },
            "points": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "radius": {
              "type": [
                "number",
                "null"
              ],
              "default": null
            },
            "plane": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "slice": {
              "type": [
                "integer",
                "null"
              ],
              "default": null
            }
          }
        },
        "schematic": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "id of a generic sign schematic (content/signs) when the sign cannot be drawn from the mask"
        }
      }
    }
  },
  "properties": {
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "success": {
      "type": "boolean"
    },
    "outcomes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Outcome"
      }
    },
    "reveal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findings",
        "marks",
        "arrows",
        "search"
      ],
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RevealFinding"
          }
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RevealMark"
          }
        },
        "arrows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Arrow"
          }
        },
        "search": {
          "$ref": "#/$defs/SearchSummary"
        },
        "ctr": {
          "type": [
            "number",
            "null"
          ],
          "default": null
        },
        "is_normal": {
          "type": "boolean",
          "default": false
        },
        "zones_approximate": {
          "type": "boolean",
          "default": false
        },
        "maskvol_url": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "gzipped uint8 label volume, served only after submit"
        },
        "modality": {
          "type": "string",
          "enum": [
            "cxr",
            "ct",
            "mr"
          ],
          "default": "cxr"
        },
        "provenance": {
          "type": [
            "object",
            "null"
          ],
          "default": null,
          "additionalProperties": true
        }
      }
    },
    "facts_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "lines"
      ],
      "properties": {
        "headline": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "debrief_status": {
      "type": "string",
      "enum": [
        "pending",
        "disabled"
      ]
    }
  }
}
