{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:site": "tsc -b && VITE_BASE_PATH=/blindspot/ vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "gen:types": "node scripts/gen-types.mjs",
    "gen:brand": "node --no-warnings scripts/gen-brand.mjs",
    "test": "vitest",
    "e2e": "playwright test --config ../tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
